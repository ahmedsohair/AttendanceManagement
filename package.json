{
  "name": "algo-attendance",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@supabase/auth-js": "^2.101.1",
    "@supabase/functions-js": "^2.101.1",
    "@supabase/phoenix": "^0.4.0",
    "@supabase/postgrest-js": "^2.101.1",
    "@supabase/realtime-js": "^2.101.1",
    "@supabase/storage-js": "^2.101.1",
    "@supabase/supabase-js": "^2.56.1",
    "@types/ws": "^8.18.1",
    "iceberg-js": "^0.8.1",
    "tslib": "^2.8.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "shell-quote": "1.11.0",
    "next": {
      "postcss": {
        ".": "8.5.23",
        "nanoid": "3.3.18",
        "source-map-js": "1.2.2"
      },
      "sharp": "0.35.5"
    },
    "exceljs": {
      "uuid": "11.1.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7"
    },
    "@paddleocr/paddleocr-js": {
      "js-yaml": "4.3.2",
      "onnxruntime-web": {
        ".": "1.26.0",
        "protobufjs": "7.6.6"
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:web": "node scripts/audit-web-dependencies.mjs",
    "test:audit": "node --test scripts/tests/audit-dependencies.test.mjs scripts/tests/audit-web-dependencies.test.mjs",
    "test:operations": "node --test scripts/tests/operations-check.test.mjs",
    "test:rehearsal": "node --test scripts/tests/production-rehearsal.test.mjs scripts/tests/managed-auth-rehearsal.test.mjs scripts/tests/private-operations.test.mjs scripts/tests/rehearsal-revisions.test.mjs scripts/tests/production-upgrade.test.mjs",
    "dev:admin": "npm --workspace @algo-attendance/admin run dev",
    "dev:mobile": "npm --workspace @algo-attendance/mobile run start",
    "build:mobile:configure": "npm --prefix apps/mobile run build:configure",
    "build:mobile:android:preview": "npm --prefix apps/mobile run build:android:preview",
    "build:mobile:android:production": "npm --prefix apps/mobile run build:android:production",
    "build:mobile:ios:preview": "npm --prefix apps/mobile run build:ios:preview",
    "build:mobile:ios:production": "npm --prefix apps/mobile run build:ios:production",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test:web": "npm --workspace @algo-attendance/shared test && npm --workspace @algo-attendance/admin run test:api && npm --workspace @algo-attendance/admin run test:server-unit && npm --workspace @algo-attendance/admin run test:scanner",
    "test:staging-api": "powershell -ExecutionPolicy Bypass -File ./scripts/test-staging-api-contracts.ps1 -ConfirmStagingTest",
    "test:staging-concurrency": "powershell -ExecutionPolicy Bypass -File ./scripts/test-concurrent-attendance-staging.ps1 -ConfirmStagingTest",
    "test:staging-browser": "playwright test",
    "test:staging-load": "powershell -ExecutionPolicy Bypass -File ./scripts/test-staging-load.ps1 -ConfirmStagingTest",
    "telemetry:summary": "node --experimental-strip-types scripts/summarize-api-telemetry.mjs",
    "typecheck:web": "tsc -p packages/shared/tsconfig.json --noEmit --incremental false && tsc -p apps/admin/tsconfig.json --noEmit --incremental false",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "create:admin": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/create-admin.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  }
}
